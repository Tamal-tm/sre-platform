# Terraform local state, cache, and logs
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files (may contain your IP or other machine-specific values)
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# SSH private key generated by keypair.tf - never commit this
infra/sre-platform-key.pem
